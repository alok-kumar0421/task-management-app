# Supabase Configuration
# Use the anon public key for basic operations, or service_role key for admin operations
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Gmail API Configuration
# Put the content of your token.json here for production deployment
# In local development, you can just keep the `token.json` file in the backend directory.
GMAIL_TOKEN_JSON=